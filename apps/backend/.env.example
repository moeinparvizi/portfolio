# Local development only. Copy to apps/backend/.env.
DATABASE_URL=postgresql://portfolio:portfolio@localhost:5432/portfolio
JWT_SECRET=replace-with-a-unique-random-secret
JWT_REFRESH_SECRET=replace-with-another-unique-random-secret
JWT_EXPIRATION=15m
REFRESH_EXPIRATION=7d
PORT=3000
CORS_ORIGINS=http://localhost:4200
UPLOAD_DIR=./uploads

# Initial setup only; use your own username/password (20+ characters).
ADMIN_USERNAME=local-admin
ADMIN_PASSWORD=

# Optional: separate Supabase development project for persistent images.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=portfolio-images
